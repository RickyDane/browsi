// Default: ad-hoc signing, no passkeys. Works for anyone without an Apple Developer account.
// To enable passkeys, copy Signing.local.xcconfig.example → Signing.local.xcconfig (git-ignored)
// and fill in your team + provisioning profile. See README › Passkeys.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
PROVISIONING_PROFILE_SPECIFIER =
CODE_SIGN_ENTITLEMENTS = Browsi/Resources/Browsi.entitlements

#include? "Signing.local.xcconfig"
